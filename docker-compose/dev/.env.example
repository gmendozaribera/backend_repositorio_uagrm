# Copiar a .env y ajustar. El archivo .env no se versiona.
POSTGRES_DB=repositorio
POSTGRES_USER=repositorio
POSTGRES_PASSWORD=repositorio

REDIS_PASSWORD=redis_dev_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# work-service: bucket de los archivos de trabajos (se crea solo si no existe). En docker-compose el servicio usa
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD como MINIO_ACCESS_KEY/MINIO_SECRET_KEY; en K8s: un usuario propio por Secret
# (no el root) con permisos solo sobre este bucket. Fuera del perfil dev MINIO_URL, MINIO_ACCESS_KEY y
# MINIO_SECRET_KEY son OBLIGATORIAS.
MINIO_BUCKET=trabajos

# auth-service. Generar un secreto propio: openssl rand -base64 32
# En dev se usa un secreto de desarrollo del perfil dev (nunca en produccion). En K8s llega por Secret.
ADMIN_INICIAL_PASSWORD=Admin2026.

# user-service: llave AES-256 de los parametros secretos de la tabla dominio (p. ej. la contrasena SMTP).
# Base64 de 32 bytes: openssl rand -base64 32. Fuera del perfil dev es OBLIGATORIA (el servicio no arranca sin ella).
# Si se cambia, hay que volver a guardar los secretos (SMTP_GROUP.PASSWORD). En K8s llega por Secret.
DOMINIO_CIFRADO_KEY=ZGV2LXNvbG8tY2lmcmFkby1kb21pbmlvLTMyYnl0ZXM=
