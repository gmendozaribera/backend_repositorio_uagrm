// Sprint 1: pipeline basico build + test. Docker build/push y kubectl apply llegan en Sprint 5.
pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Lint de los contratos OpenAPI + deteccion de cambios incompatibles contra main (requiere Node y Docker).
        // Los tests de contrato (AuthContratoTest) corren en la etapa Test.
        stage('Contratos') {
            steps {
                sh 'git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main'
                sh 'bash script/contratos.sh origin/main'
            }
        }

        stage('Build') {
            steps {
                sh './gradlew clean assemble --no-daemon'
            }
        }

        stage('Test') {
            steps {
                sh './gradlew test --no-daemon'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/build/test-results/test/*.xml'
                }
            }
        }
    }
}
